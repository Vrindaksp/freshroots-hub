# Copy to .env.local (local) or add to Vercel → Settings → Environment Variables (production).

# Neon connection string (pooled). Leave empty locally to use the embedded Postgres in .data/pglite.
# Required in production.
DATABASE_URL=

# Gemini API key from https://aistudio.google.com/apikey — server-side only, never exposed to the browser.
# Without it the app still works: commentary, note parsing and the executive brief fall back to rule-based text.
GEMINI_API_KEY=
# Model IDs change on Google's schedule; override here without a code change.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# EMERGENCY HARD STOP. Set to 1 (or true/on) and redeploy to stop ALL automation: engine, Gemini and PO sign-off.
# It overrides the in-app Kill switch and cannot be resumed from the app. Leave empty normally.
KILL_SWITCH=

# Bearer token for POST /api/ingest (the push replacement for the Monday SAP→Excel export). Ingest is disabled when empty.
INGEST_TOKEN=

# Vercel Cron sends this as `Authorization: Bearer …` to /api/cron/refresh. Required in production.
CRON_SECRET=
